/* ZINJA Pickleball Club - Glass UI (REPLACE the old style.css completely) */
*{box-sizing:border-box;margin:0;padding:0}
:root{--glass:rgba(255,255,255,.82);--glass-dark:rgba(15,25,60,.55);--line:rgba(255,255,255,.35);--pur:#7c3aed;--grn:#10b981;--pink:#831843}
html,body{font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;color:#fff;min-height:100%;overflow-x:hidden}
body{background:#0a1a3a;background-image:radial-gradient(circle at 12% 8%,rgba(124,58,237,.6),transparent 42%),radial-gradient(circle at 88% 30%,rgba(6,182,212,.4),transparent 42%),radial-gradient(circle at 25% 92%,rgba(236,72,153,.38),transparent 46%);background-attachment:fixed}
h2{font-size:1.25em;margin-bottom:12px}h3{font-size:1.05em;margin:16px 0 10px}p{line-height:1.5;color:#e5e7eb}
button{font-family:inherit}

/* Navbar */
.navbar{position:sticky;top:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:10px 16px;background:var(--glass-dark);backdrop-filter:blur(18px) saturate(160%);-webkit-backdrop-filter:blur(18px) saturate(160%);border-bottom:1px solid var(--line)}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none;color:#fff}
.nav-logo img{height:46px;width:auto}
.nav-logo-text{display:flex;flex-direction:column;line-height:1}
.nav-logo-text strong{font-size:1.25em;font-weight:900;letter-spacing:1px}
.nav-logo-text small{font-size:.6em;letter-spacing:3px;font-weight:700;margin-top:3px;color:#e5e7eb}
.hamburger{background:rgba(255,255,255,.12);border:1px solid var(--line);border-radius:12px;cursor:pointer;padding:10px;display:flex;flex-direction:column;gap:5px}
.hamburger span{width:22px;height:3px;background:#fff;border-radius:2px}
.slide-menu{position:fixed;top:0;right:-310px;width:280px;height:100vh;height:100dvh;z-index:200;padding:22px 18px;overflow-y:auto;transition:right .3s;background:rgba(10,20,50,.7);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-left:1px solid var(--line)}
.slide-menu.open{right:0}
.slide-menu .close-btn{float:right;background:none;border:none;color:#fff;font-size:1.6em;cursor:pointer}
.slide-menu h3{clear:both;color:#c084fc;font-size:.75em;letter-spacing:2px;text-transform:uppercase}
.slide-menu a{display:block;padding:12px 14px;margin-bottom:4px;border-radius:12px;color:#fff;font-weight:600;cursor:pointer}
.slide-menu a:hover{background:rgba(255,255,255,.15)}
.slide-menu .icon{margin-right:10px}
.menu-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:150;display:none}
.menu-overlay.open{display:block}

/* Banners */
#liveStatus{padding:10px 16px;text-align:center;font-size:.88em;font-weight:600}
.weekly-banner{padding:8px 16px;text-align:center;font-size:.8em;background:rgba(124,58,237,.35);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}

/* Pages */
.page{display:none}.page.active{display:block}
.page-inner{max-width:900px;margin:0 auto;padding:18px 14px 60px}
.page-header{display:flex;align-items:center;gap:12px;padding:12px 16px;margin-bottom:18px;border-radius:18px;background:rgba(124,58,237,.45);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid var(--line);box-shadow:0 8px 30px rgba(0,0,0,.25)}
.page-header button,#page-chat .chat-top button{background:rgba(255,255,255,.22);border:none;color:#fff;padding:8px 16px;border-radius:20px;font-weight:700;cursor:pointer}
.page-header h2{flex:1;text-align:center;padding-right:60px;margin:0;font-size:1.05em}

/* Live board */
.live-top{max-width:900px;margin:18px auto 8px;padding:0 14px}
.live-top-header h2{display:flex;align-items:center;gap:8px;font-weight:900}
.live-dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--grn);box-shadow:0 0 12px var(--grn);animation:pulse 1.5s infinite}
@keyframes pulse{50%{opacity:.5;transform:scale(1.25)}}
.live-empty{text-align:center;padding:22px;border-radius:18px;background:var(--glass-dark);border:1px solid var(--line);backdrop-filter:blur(14px)}

/* Hero */
.hero{margin:14px;border-radius:26px;padding:38px 24px;position:relative;overflow:hidden;background:var(--glass-dark);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid var(--line);box-shadow:0 16px 50px rgba(0,0,0,.35)}
.hero::before{content:'🏓';position:absolute;right:-4%;top:8%;font-size:16em;opacity:.12;transform:rotate(-20deg);pointer-events:none}
.hero-inner{max-width:860px;margin:0 auto;position:relative;z-index:2}
.welcome{font-size:.85em;letter-spacing:5px;font-weight:700}
.hero h1{font-size:3.2em;font-weight:900;letter-spacing:2px;line-height:1;margin:6px 0;text-shadow:0 4px 24px rgba(0,0,0,.4)}
.hero .subtitle{font-size:1.5em;font-weight:800;letter-spacing:4px;color:#fff;margin-bottom:16px}
.location{display:inline-block;padding:8px 18px;border-radius:24px;font-size:.85em;margin-bottom:20px;background:rgba(255,255,255,.14);border:1px solid var(--line)}
.tagline{font-size:1.3em;font-weight:800;color:#fff}
.description{max-width:480px;margin:8px 0 22px}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px}
.hero-btn{flex:1;min-width:200px;max-width:320px;padding:15px 28px;border-radius:50px;font-weight:800;font-size:1.02em;cursor:pointer;color:#fff;border:1px solid var(--line);transition:transform .15s}
.hero-btn:hover{transform:translateY(-2px)}
.hero-btn.primary{background:linear-gradient(135deg,#10b981,#059669);box-shadow:0 8px 28px rgba(16,185,129,.45)}
.hero-btn.secondary{background:rgba(255,255,255,.12);backdrop-filter:blur(8px)}

/* Stats */
.stat-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:900px;margin:0 auto 24px;padding:0 14px}
.stat-card{display:flex;align-items:center;gap:12px;padding:16px;border-radius:18px;background:var(--glass-dark);border:1px solid var(--line);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);box-shadow:0 8px 24px rgba(0,0,0,.25)}
.stat-card .ico{font-size:1.8em}.stat-card .txt{display:flex;flex-direction:column}
.stat-card .num{font-weight:900}.stat-card .lbl{font-size:.78em;opacity:.85}

/* Features */
.features-wrap{padding:10px 14px}
.features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;max-width:900px;margin:0 auto}
.feature-card{display:flex;flex-direction:column;align-items:center;text-align:center;padding:20px 14px;border-radius:20px;cursor:pointer;background:var(--glass);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid var(--line);box-shadow:0 8px 24px rgba(0,0,0,.25);transition:.2s}
.feature-card:hover{transform:translateY(-3px);box-shadow:0 14px 34px rgba(124,58,237,.4)}
.feature-icon{width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5em;margin-bottom:10px;background:rgba(124,58,237,.15)}
.feature-card .title{font-weight:800;color:var(--pink);margin-bottom:4px}
.feature-card .desc{font-size:.82em;color:#9d174d}

/* Facility */
.facility{max-width:900px;margin:26px auto;padding:0 14px}
.facility-inner{padding:26px 22px;border-radius:22px;background:var(--glass-dark);border:1px solid var(--line);backdrop-filter:blur(16px)}
.facility .label{color:#4ade80;font-size:.75em;font-weight:800;letter-spacing:3px;margin-bottom:6px}
.facility h2{font-size:1.6em;font-weight:900}
.facility-bullets{display:flex;flex-wrap:wrap;gap:20px}

/* Schedule */
.schedule-wrap{padding:24px 14px 50px}.schedule-inner{max-width:900px;margin:0 auto}
.schedule-header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.schedule-header a{color:#c084fc;font-weight:700;cursor:pointer}
.day-tabs{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:16px}
.day-tab{padding:11px 2px;border-radius:12px;font-weight:800;font-size:.8em;cursor:pointer;color:#e0e7ff;background:rgba(255,255,255,.1);border:1px solid var(--line);backdrop-filter:blur(8px)}
.day-tab.closed{color:#fca5a5}
.day-tab.active{background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff}
.day-tab.active.closed{background:linear-gradient(135deg,#dc2626,#991b1b)}
.schedule-panel,.card{background:var(--glass);color:#4b5563;border-radius:20px;padding:20px;margin-bottom:16px;border:1px solid var(--line);backdrop-filter:blur(18px) saturate(150%);-webkit-backdrop-filter:blur(18px) saturate(150%);box-shadow:0 10px 32px rgba(0,0,0,.28)}
.schedule-panel h4,.card h3,.card strong,.card b{color:var(--pink)}
.card p{color:#4b5563}
.schedule-row{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid rgba(131,24,67,.15);font-size:.92em}
.schedule-row:last-child{border:none}
.schedule-row .label{color:#9d174d;font-weight:600}.schedule-row .value{color:var(--pink);font-weight:700;text-align:right}
.schedule-row .value.closed{color:#dc2626}
.date-group h4{color:var(--pur)}

/* Forms */
input,select,textarea{width:100%;padding:13px 14px;margin-bottom:10px;border-radius:12px;font-size:1em;font-family:inherit;color:#111;background:rgba(255,255,255,.9);border:1.5px solid rgba(249,168,212,.9)}
input:focus,select:focus,textarea:focus{outline:none;border-color:#ec4899;box-shadow:0 0 0 3px rgba(236,72,153,.2)}
.btn{display:inline-block;padding:12px 22px;border:none;border-radius:12px;font-weight:700;font-size:1em;cursor:pointer;color:#fff;background:linear-gradient(135deg,#7c3aed,#6d28d9);box-shadow:0 4px 14px rgba(124,58,237,.4);transition:transform .15s}
.btn:hover{transform:translateY(-1px)}.btn:disabled{opacity:.6;cursor:not-allowed}
.btn.alt{background:linear-gradient(135deg,#10b981,#059669)}
.btn.danger{background:linear-gradient(135deg,#ef4444,#dc2626)}
.btn.sm{padding:7px 14px;font-size:.85em}

/* Admin */
.admin-tab-btn{padding:10px 18px;border-radius:10px;border:2px solid #ddd;background:#fff;color:#333;font-weight:700;cursor:pointer}
#adminData{color:#1f2937}
.admin-card{position:relative;background:rgba(255,255,255,.92);color:#374151;border-radius:16px;padding:16px;margin-bottom:12px;box-shadow:0 4px 14px rgba(0,0,0,.12)}
.admin-card h4{color:var(--pur);margin-bottom:6px}.admin-card p{color:#374151;margin:3px 0;font-size:.92em}
.row-btns{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}

/* Chat */
#page-chat.active{display:flex;flex-direction:column;height:calc(100vh - 110px);height:calc(100dvh - 110px)}
.chat-wrap{display:flex;flex-direction:column;height:100%;max-width:900px;margin:0 auto;width:100%;background:var(--glass);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.chat-top{display:flex;align-items:center;gap:12px;padding:12px 16px;background:linear-gradient(135deg,#7c3aed,#6d28d9)}
.chat-top h2{margin:0;flex:1;font-size:1.05em}
.chat-note{padding:8px 12px;font-size:.8em;color:#9d174d;text-align:center;background:rgba(252,231,243,.8)}
.chat-name{padding:8px 12px}.chat-name input{margin:0}
#chatMessages{flex:1;overflow-y:auto;padding:14px}
.chat-input-row{display:flex;gap:8px;padding:10px;background:rgba(255,255,255,.9)}
.chat-input-row input{margin:0}
.emoji-btn{background:#fce7f3;border:1.5px solid #fbcfe8;border-radius:10px;padding:8px 10px;font-size:1.2em;cursor:pointer}
#emojiPicker{display:none;background:#fff;padding:10px;max-height:180px;overflow-y:auto}
#emojiPicker .grid{display:grid;grid-template-columns:repeat(8,1fr);gap:5px}

/* Modal */
.modal-overlay{position:fixed;inset:0;z-index:500;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(0,0,0,.6);backdrop-filter:blur(6px)}
.modal-overlay.open{display:flex}
.modal-content{width:100%;max-width:400px;text-align:center;padding:24px;border-radius:22px;color:#111;background:rgba(255,255,255,.92);backdrop-filter:blur(20px);box-shadow:0 14px 50px rgba(0,0,0,.5)}
.modal-content h3{color:var(--pur)}.modal-content p{color:#374151}
.amount{font-size:2em;font-weight:900;color:var(--grn);margin:10px 0}
.gcash-info{background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:12px;margin-bottom:14px;text-align:left}
.gcash-info p{color:#1e3a8a;margin:4px 0}
.refund-note{font-size:.8em;color:#dc2626;background:#fef2f2;padding:10px;border-radius:10px;margin-bottom:14px;text-align:left}

footer{text-align:center;padding:28px 20px;color:#c7d2fe;font-size:.85em;background:var(--glass-dark);backdrop-filter:blur(12px);border-top:1px solid var(--line)}

/* Mobile */
@media(max-width:640px){
.hero{margin:10px;padding:28px 18px}.hero h1{font-size:2.4em}.hero .subtitle{font-size:1.1em;letter-spacing:2.5px}
.hero-actions{flex-direction:column}.hero-btn{max-width:none}
.stat-cards{grid-template-columns:1fr}
.features-grid{grid-template-columns:repeat(2,1fr);gap:10px}.feature-card{padding:16px 8px}
.facility-bullets{flex-direction:column;gap:10px}
.day-tab{font-size:.7em;padding:10px 0}
.nav-logo img{height:40px}.nav-logo-text strong{font-size:1.05em}
.schedule-row{flex-direction:column;gap:2px}.schedule-row .value{text-align:left}
}
